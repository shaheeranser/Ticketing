# ==============================================================================
# MEHFIL-E-SAMA QAWWALI TICKETING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=eventpass_db

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=payment-receipts

# ------------------------------------------------------------------------------
# SMTP Configuration for Automatic Ticket Delivery
# Use Gmail App Password or any standard SMTP service (Sendgrid, Mailgun, etc.)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="Mehfil-e-Sama Invitations <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# Default Admin Portal Credentials (URL: /admin)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SufiNight2026!
