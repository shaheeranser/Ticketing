# ==============================================================================
# SUR O SUROOR TICKETING SYSTEM - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=eventpass_db

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=payment-receipts

# ------------------------------------------------------------------------------
# SMTP Configuration for Automatic Ticket Delivery
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="Sur o Suroor Invitations"

# ------------------------------------------------------------------------------
# Promo / Referral Codes Configuration
# ------------------------------------------------------------------------------
PROMO_CODES_25=
PROMO_CODES_FREE=

# ------------------------------------------------------------------------------
# 4 Admins Configuration (Strictly 4 Admins Only)
# ------------------------------------------------------------------------------
ADMIN_1_USER=admin1
ADMIN_1_PASS=your_secure_password_here
ADMIN_1_NAME="Admin 1"

ADMIN_2_USER=admin2
ADMIN_2_PASS=your_secure_password_here
ADMIN_2_NAME="Admin 2"

ADMIN_3_USER=admin3
ADMIN_3_PASS=your_secure_password_here
ADMIN_3_NAME="Admin 3"

ADMIN_4_USER=admin4
ADMIN_4_PASS=your_secure_password_here
ADMIN_4_NAME="Admin 4"
